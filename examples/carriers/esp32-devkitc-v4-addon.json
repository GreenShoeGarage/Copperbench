  "assumptions": [
    {
      "id": "esp32-devkitc-v4-addon-assume-002",
      "text": "Two copper layers; through vias only. This layout does not verify circuit function.",
      "status": "open"
    },
    {
      "id": "esp32-devkitc-v4-addon-a-004",
      "text": "3.3 V I/O. Flash contacts are reserved; review input-only and boot-strapping pins. Use the WROOM-32E host, not WROVER or an arbitrary 30/38-pin clone.",
      "status": "open"
    },
    {
      "id": "esp32-devkitc-v4-addon-a-005",
      "text": "19 contacts per bank, 25.4 mm row separation. Reference envelope includes nominal 6.04 mm antenna-module overhang above the 48.26 mm host PCB. USB is at the bottom. No mounting holes.",
      "status": "open"
    },
    {
      "id": "esp32-devkitc-v4-addon-a-006",
      "text": "Header mounting only: no castellated reflow pads, underside USB/battery/test contacts or debug connector are included.",
      "status": "open"
    },
    {
      "id": "esp32-devkitc-v4-addon-a-007",
      "text": "Nominal 1.0 mm connector drills / 1.8 mm pads are defaults. Check the actual mating connector, assembly tolerance and engagement length.",
      "status": "open"
    },
    {
      "id": "esp32-devkitc-v4-addon-a-008",
      "text": "Pin captions do not join nets. Confirm power direction, voltage and current limits; no supporting power circuitry is inserted.",
      "status": "open"
    },
    {
      "id": "esp32-devkitc-v4-addon-a-009",
      "text": "The host envelope and access areas are 2D references, not a collision-checked mechanical model. Print at 1:1 and verify against the purchased board before ordering.",
      "status": "open"
    },
    {
      "id": "esp32-devkitc-v4-addon-a-010",
      "text": "Host-edge/header offsets are nominal centered offsets; confirm the exact PCB and module revision.",
      "status": "open"
    },
    {
      "id": "esp32-devkitc-v4-addon-a-011",
      "text": "The suggested RF guard only reserves the antenna projection and extension; apply the full module/manufacturer guidance for nearby copper and metal.",
      "status": "open"
    },
    {
      "id": "esp32-devkitc-v4-addon-a-012",
      "text": "GPIO16/17 use differs on WROVER modules; this template is specifically WROOM-32E.",
      "status": "open"
    },
    {
      "id": "esp32-devkitc-v4-addon-a-014",
      "text": "8.5 mm underside stack gap is an editable planning assumption, not a measured connector specification. RF/access rectangles are suggested 2D references requiring review.",
      "status": "open"
    }
  ],
  "evidence": [
    {
      "id": "esp32-devkitc-v4-addon-e-013",
      "text": "Nominal mating geometry transcribed from published pinouts/dimensioned references; no physical fit or manufacturer acceptance verified.",
      "source": "https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32/esp32-devkitc/user_guide.html\nhttps://dl.espressif.com/dl/schematics/esp32_devkitc_v4_dimensions.pdf\nhttps://docs.espressif.com/projects/esp-hardware-design-guidelines/en/latest/esp32/pcb-layout-design.html"
    },
    {
