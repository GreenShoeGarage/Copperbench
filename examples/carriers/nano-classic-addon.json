  "assumptions": [
    {
      "id": "nano-classic-addon-assume-002",
      "text": "Two copper layers; through vias only. This layout does not verify circuit function.",
      "status": "open"
    },
    {
      "id": "nano-classic-addon-a-004",
      "text": "Classic ATmega328P Nano uses 5 V I/O. A6 and A7 are analog inputs, not general digital pins.",
      "status": "open"
    },
    {
      "id": "nano-classic-addon-a-005",
      "text": "Classic Nano only, not Nano Every / 33 / ESP32. 15.24 mm row separation. The 43.2 × 18 mm envelope follows the A000005 mechanical drawing, not a marketing-length claim; verify clones separately.",
      "status": "open"
    },
    {
      "id": "nano-classic-addon-a-006",
      "text": "Header mounting only: no castellated reflow pads, underside USB/battery/test contacts or debug connector are included.",
      "status": "open"
    },
    {
      "id": "nano-classic-addon-a-007",
      "text": "Nominal 1.0 mm connector drills / 1.8 mm pads are defaults. Check the actual mating connector, assembly tolerance and engagement length.",
      "status": "open"
    },
    {
      "id": "nano-classic-addon-a-008",
      "text": "Pin captions do not join nets. Confirm power direction, voltage and current limits; no supporting power circuitry is inserted.",
      "status": "open"
    },
    {
      "id": "nano-classic-addon-a-009",
      "text": "The host envelope and access areas are 2D references, not a collision-checked mechanical model. Print at 1:1 and verify against the purchased board before ordering.",
      "status": "open"
    },
    {
      "id": "nano-classic-addon-a-010",
      "text": "Optional 1.8 mm mounting-hole pattern is nominal; verify screw clearance near the end contacts.",
      "status": "open"
    },
    {
      "id": "nano-classic-addon-a-011",
      "text": "ICSP is not included. USB-up orientation; contact 1 is TX at the lower right, contact 16 is D13 at the upper left.",
      "status": "open"
    },
    {
      "id": "nano-classic-addon-a-013",
      "text": "8.5 mm underside stack gap is an editable planning assumption, not a measured connector specification. RF/access rectangles are suggested 2D references requiring review.",
      "status": "open"
    }
  ],
  "evidence": [
    {
      "id": "nano-classic-addon-e-012",
