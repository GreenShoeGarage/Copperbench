  "assumptions": [
    {
      "id": "xiao-esp32c3-addon-assume-002",
      "text": "Two copper layers; through vias only. This layout does not verify circuit function.",
      "status": "open"
    },
    {
      "id": "xiao-esp32c3-addon-a-004",
      "text": "3.3 V I/O. 5V/VBUS is not a 5 V GPIO. Pin labels identify this exact variant; review power direction and boot pins.",
      "status": "open"
    },
    {
      "id": "xiao-esp32c3-addon-a-005",
      "text": "Original 14-contact host, two 7-way rows on a nominal 15.24 mm span. Centered header offsets in a 17.8 × 21 mm reference envelope require physical review. No mounting holes. Not XIAO Plus or other XIAO variants.",
      "status": "open"
    },
    {
      "id": "xiao-esp32c3-addon-a-006",
      "text": "Header mounting only: no castellated reflow pads, underside USB/battery/test contacts or debug connector are included.",
      "status": "open"
    },
    {
      "id": "xiao-esp32c3-addon-a-007",
      "text": "Nominal 1.0 mm connector drills / 1.8 mm pads are defaults. Check the actual mating connector, assembly tolerance and engagement length.",
      "status": "open"
    },
    {
      "id": "xiao-esp32c3-addon-a-008",
      "text": "Pin captions do not join nets. Confirm power direction, voltage and current limits; no supporting power circuitry is inserted.",
      "status": "open"
    },
    {
      "id": "xiao-esp32c3-addon-a-009",
      "text": "The host envelope and access areas are 2D references, not a collision-checked mechanical model. Print at 1:1 and verify against the purchased board before ordering.",
      "status": "open"
    },
    {
      "id": "xiao-esp32c3-addon-a-010",
      "text": "Contact IDs follow the printed D0–D10 and power labels. USB-up top view; no battery/debug pads on the underside are added.",
      "status": "open"
    },
    {
      "id": "xiao-esp32c3-addon-a-011",
      "text": "ESP32C3 uses an external antenna. The amber connector-access rectangle is NOT an on-board antenna copper guard; route and position the actual antenna/coax separately.",
      "status": "open"
    },
    {
      "id": "xiao-esp32c3-addon-a-013",
      "text": "8.5 mm underside stack gap is an editable planning assumption, not a measured connector specification. RF/access rectangles are suggested 2D references requiring review.",
      "status": "open"
    }
  ],
  "evidence": [
    {
      "id": "xiao-esp32c3-addon-e-012",
      "text": "Nominal mating geometry transcribed from published pinouts/dimensioned references; no physical fit or manufacturer acceptance verified.",
      "source": "https://wiki.seeedstudio.com/XIAO_ESP32C3_Getting_Started/\nhttps://wiki.seeedstudio.com/PCB_Design_XIAO/"
    },
    {
      "id": "xiao-esp32c3-addon-e-014",
      "text": "v1.5 controller interface: header pinout and nominal geometry source-referenced; physical fit, electrical function and manufacturing acceptance NOT verified.",
      "source": "https://wiki.seeedstudio.com/XIAO_ESP32C3_Getting_Started/\nhttps://wiki.seeedstudio.com/PCB_Design_XIAO/"
    }
  ],
