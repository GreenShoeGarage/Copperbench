    {
      "id": "uno-r3-addon-assume-2",
      "text": "Two copper layers; through vias only. This layout does not verify circuit function.",
      "status": "open"
    },
    {
      "id": "uno-r3-addon-a-4",
      "text": "Uno R3 / ATmega328P reference: 5 V I/O. Check IOREF and power direction.",
      "status": "open"
    },
    {
      "id": "uno-r3-addon-a-5",
      "text": "32 perimeter contacts (8 power + 6 analog + 10 + 8 digital). USB-left top view. The 4.064 mm D8–D7 gap is intentional. No ICSP 2×3 header or R4-specific features are included.",
      "status": "open"
    },
    {
      "id": "uno-r3-addon-a-6",
      "text": "Verify the selected Uno R3 or clone against the nominal header and mounting-hole coordinates before ordering.",
      "status": "open"
    },
    {
      "id": "uno-r3-addon-a-7",
      "text": "Choose male / stackable shield headers; check tail length, spacer height, USB-B and barrel-jack clearance.",
      "status": "open"
    },
    {
      "id": "uno-r3-addon-a-8",
      "text": "ICSP is not included. Add and verify it separately when your shield requires an ICSP SPI connection.",
      "status": "open"
    },
    {
      "id": "uno-r3-addon-a-9",
      "text": "No blanket electrical/mechanical compatibility claim for Uno R4, Uno Q, Mega, or third-party clones.",
      "status": "open"
    }
